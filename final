'Inglês': 'Pratique o uso de conectores estruturais para enriquecer seu texto. Lembre-se de verificar o uso correto dos tempos verbais na língua inglesa.',
'Educação Física': 'Aborde a importância da saúde integral e do bem-estar do corpo. Explique as regras, história ou impactos anatômicos da atividade indicada.'
};
// Função simples para passar da tela inicial
function enterPortal() {
const year = document.getElementById('student-year').value;
document.getElementById('student-badge').innerText = Ano: ${year};
document.getElementById('login-screen').style.display = 'none';
}
// Troca de matéria e atualização instantânea da IA
function selectSubject(element, subjectName) {
document.querySelectorAll('.subject-item').forEach(item => item.classList.remove('active'));
element.classList.add('active');
document.getElementById('current-subject-title').innerText = Trabalho de ${subjectName};
// Atualiza a IA Orientadora com a diretriz da matéria
document.getElementById('ai-suggestion').innerHTML = <strong>Diretriz para ${subjectName}:</strong><br>${aiGuidelines[subjectName]};
// Limpa o editor para o novo trabalho simulado
document.getElementById('work-text').value = '';
document.getElementById('image-area').innerHTML = '';
}
// Função do Recurso 1: Adicionar o PNG sem fundo na tela
function insertPng(src) {
const wrapper = document.createElement('div');
wrapper.className = 'inserted-img-wrapper';
wrapper.innerHTML = <img src="${src}" class="inserted-img"> <button class="remove-btn" onclick="this.parentElement.remove()">×</button>;
document.getElementById('image-area').appendChild(wrapper);
}
// Upload de imagem do próprio computador
function handleFileUpload(input) {
if (input.files && input.files[0]) {
const reader = new FileReader();
reader.onload = function(e) {
insertPng(e.target.result);
};
reader.readAsDataURL(input.files[0]);
}
