<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal Tecnológico - Educação Adventista</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #0d0d0d;
            color: #e0e0e0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* Container Principal de Login */
        .login-container {
            background-color: #141414;
            border: 2px solid #00ff66;
            box-shadow: 0 0 20px rgba(0, 255, 102, 0.2);
            border-radius: 12px;
            padding: 40px;
            width: 100%;
            max-width: 450px;
            text-align: center;
            transition: all 0.3s ease;
        }

        .logo-escrita {
            color: #00ff66;
            font-size: 1.8rem;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 5px;
            text-shadow: 0 0 10px rgba(0, 255, 102, 0.5);
        }

        .sub-logo {
            color: #888;
            font-size: 0.9rem;
            margin-bottom: 30px;
        }

        /* Abas de Navegação */
        .tabs {
            display: flex;
            justify-content: space-between;
            margin-bottom: 25px;
            border-bottom: 1px solid #333;
        }

        .tab-btn {
            background: none;
            border: none;
            color: #888;
            padding: 10px 20px;
            cursor: pointer;
            font-size: 1rem;
            font-weight: 600;
            width: 50%;
            transition: all 0.3s ease;
        }

        .tab-btn.active {
            color: #00ff66;
            border-bottom: 3px solid #00ff66;
        }

        /* Formulários e Inputs */
        .form-group {
            text-align: left;
            margin-bottom: 20px;
        }

        label {
            display: block;
            color: #aaa;
            font-size: 0.85rem;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        input, select {
            width: 100%;
            padding: 12px;
            background-color: #1a1a1a;
            border: 1px solid #333;
            border-radius: 6px;
            color: #fff;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        input:focus, select:focus {
            outline: none;
            border-color: #00ff66;
            box-shadow: 0 0 8px rgba(0, 255, 102, 0.3);
        }

        .btn-submit {
            width: 100%;
            padding: 14px;
            background-color: #00ff66;
            color: #000;
            border: none;
            border-radius: 6px;
            font-size: 1rem;
            font-weight: bold;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-top: 10px;
            transition: all 0.3s ease;
        }

        .btn-submit:hover {
            background-color: #00cc52;
            box-shadow: 0 0 15px rgba(0, 255, 102, 0.4);
        }

        .hidden {
            display: none !important;
        }

        /* Simulação de Reconhecimento Facial */
        .camera-box {
            width: 100%;
            height: 200px;
            background-color: #1a1a1a;
            border: 2px dashed #00ff66;
            border-radius: 8px;
            margin-bottom: 20px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: relative;
            overflow: hidden;
        }

        .camera-box .scanner-line {
            position: absolute;
            width: 100%;
            height: 4px;
            background-color: #00ff66;
            top: 0;
            box-shadow: 0 0 10px #00ff66;
            animation: scan 2s linear infinite;
            display: none;
        }

        @keyframes scan {
            0% { top: 0; }
            50% { top: 100%; }
            100% { top: 0; }
        }

        .camera-icon {
            font-size: 2.5rem;
            margin-bottom: 10px;
            color: #555;
        }

        /* Mensagens de Feedback */
        .message {
            margin-top: 15px;
            font-size: 0.9rem;
            padding: 10px;
            border-radius: 6px;
            display: none;
        }
        .error { background-color: rgba(255, 0, 50, 0.1); color: #ff3344; border: 1px solid #ff3344; }
        .success { background-color: rgba(0, 255, 102, 0.1); color: #00ff66; border: 1px solid #00ff66; }

        /* --- DASHBOARD PRINCIPAL (Pós-Login) --- */
        .dashboard-container {
            width: 95%;
            max-width: 1200px;
            background-color: #141414;
            border: 1px solid #333;
            border-radius: 12px;
            padding: 30px;
            display: grid;
            grid-template-columns: 300px 1px flex;
            gap: 25px;
        }

        @media (max-width: 900px) {
            .dashboard-container { grid-template-columns: 1fr; }
            .divider-v { display: none; }
        }

        .panel-sidebar {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .user-profile {
            background-color: #1a1a1a;
            padding: 20px;
            border-radius: 8px;
            border-left: 4px solid #00ff66;
        }

        .subject-menu {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .subject-btn {
            background-color: #1a1a1a;
            border: 1px solid #222;
            color: #ccc;
            padding: 12px;
            text-align: left;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .subject-btn:hover, .subject-btn.active {
            background-color: #00ff66;
            color: #000;
            font-weight: bold;
        }

        .divider-v {
            background-color: #222;
            height: 100%;
        }

        .workspace {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        /* Editor de Conteúdo */
        .editor-box {
            background-color: #1a1a1a;
            padding: 20px;
            border-radius: 8px;
            border: 1px solid #333;
        }

        textarea {
            width: 100%;
            height: 150px;
            background-color: #111;
            border: 1px solid #333;
            color: #fff;
            padding: 12px;
            border-radius: 6px;
            resize: none;
            margin-bottom: 15px;
        }

        textarea:focus {
            outline: none;
            border-color: #00ff66;
        }

        .file-upload-wrapper {
            position: relative;
            margin-bottom: 15px;
        }

        .file-upload-label {
            display: block;
            background-color: #222;
            border: 1px dashed #00ff66;
            color: #00ff66;
            padding: 12px;
            text-align: center;
            border-radius: 6px;
            cursor: pointer;
        }

        .preview-zone {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 15px;
        }

        .preview-item {
            position: relative;
            width: 100px;
            height: 100px;
            border: 1px solid #444;
            border-radius: 6px;
            background-size: cover;
            background-position: center;
        }

        /* Painel do Orientador de IA */
        .ai-assistant {
            background-color: #0d1f14;
            border: 1px solid #00ff66;
            border-radius: 8px;
            padding: 20px;
        }

        .ai-title {
            color: #00ff66;
            font-weight: bold;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .ai-response {
            font-size: 0.95rem;
            line-height: 1.5;
            color: #b3ffcc;
        }

        .logout-btn {
            background: none;
            border: 1px solid #ff3344;
            color: #ff3344;
            padding: 8px 15px;
            border-radius: 4px;
            cursor: pointer;
            align-self: flex-start;
            margin-top: auto;
            transition: all 0.2s;
        }

        .logout-btn:hover {
            background-color: #ff3344;
            color: #fff;
        }
    </style>
</head>
<body>

    <!-- TELA DE AUTENTICAÇÃO (LOGIN) -->
    <div class="login-container" id="authScreen">
        <div class="logo-escrita">Colégio Adventista</div>
        <div class="sub-logo">Plataforma de Trabalhos 2026</div>

        <div class="tabs">
            <button class="tab-btn active" id="tabAluno" onclick="switchTab('aluno')">Área do Aluno</button>
            <button class="tab-btn" id="tabProfessor" onclick="switchTab('professor')">Área do Professor</button>
        </div>

        <!-- Formulário do Aluno -->
        <form id="formAluno" onsubmit="handleAlunoLogin(event)">
            <div class="form-group">
                <label for="emailAluno">E-mail Estudantil</label>
                <input type="text" id="emailAluno" placeholder="exemplo2026@adventista.edu" required>
            </div>
            <div class="form-group">
                <label for="anoEscolar">Ano Escolar</label>
                <select id="anoEscolar" required>
