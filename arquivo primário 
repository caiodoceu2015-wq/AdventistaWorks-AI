// Definição das 12 Matérias e as diretrizes textuais específicas da IA Orientadora
const disciplinas = [
{ id: 'portugues', nome: 'Português', prompt: 'Foque na estrutura da norma-padrão. Atente-se à concordância nominal/verbal e à coesão textual dos parágrafos.' },
{ id: 'literatura', nome: 'Literatura', prompt: 'Relacione a obra escolhida com o seu respectivo movimento literário, destacando as marcas históricas e o estilo do autor.' },
{ id: 'gramatica', nome: 'Gramática', prompt: 'Explicite as análises sintáticas aplicadas e justifique as colocações pronominais presentes nos exemplos.' },
{ id: 'matematica', nome: 'Matematica', prompt: 'Apresente o desenvolvimento lógico do problema passo a passo. Lembre-se de definir claramente as variáveis.' },
{ id: 'ensino-religioso', nome: 'Ensino Religioso', prompt: 'Promova uma reflexão baseada em valores éticos e princípios cristãos aplicados ao cotidiano e ao respeito ao próximo.' },
{ id: 'adventotech', nome: 'AdventoTech', prompt: 'Aborde o impacto tecnológico e a arquitetura computacional do projeto de forma inovadora e sustentável.' },
{ id: 'ciencias', nome: 'Ciências', prompt: 'Utilize o método científico. Descreva as hipóteses, os experimentos observados e a conclusão fundamentada.' },
{ id: 'historia', nome: 'História', prompt: 'Contextualize as causas e as consequências do fato histórico, mapeando os diferentes pontos de vista dos agentes sociais.' },
{ id: 'artes', nome: 'Artes', prompt: 'Explane as técnicas visuais empregadas e a expressividade cultural por trás das formas e das cores escolhidas.' },
{ id: 'geografia', nome: 'Geografia', prompt: 'Mapeie os aspectos socioambientais, as dinâmicas demográficas ou espaciais que compõem a região em análise.' },
{ id: 'ingles', nome: 'Inglês', prompt: 'Maintain formal grammar text. Pay attention to proper verb tense usage (Past, Present, Future Perfect) and expressions.' },
{ id: 'educacao-fisica', nome: 'Educação Física', prompt: 'Discorra sobre a biomecânica do movimento estudado, os benefícios fisiológicos da prática e as regras do esporte.' }
];
let disciplinaAtiva = disciplinas[0];
let bancoImagensTrabalho = [];
let bancoTrabalhosSubmetidos = JSON.parse(localStorage.getItem('adventista_trabalhos')) || [];
// Inicialização do Menu
function inicializarMenu() {
const menuContainer = document.getElementById('subject-menu');
menuContainer.innerHTML = '';
disciplinas.forEach((disc, index) => {
const li = document.createElement('li');
li.className = subject-item ${index === 0 ? 'active' : ''};
li.innerHTML = <span>${disc.nome}</span> <span style="font-size:10px; color:var(--primary);">•</span>;
li.onclick = () => mudarDisciplina(disc, li);
menuContainer.appendChild(li);
});
atualizarTutorIA();
}
// Fluxo de Login
function loginEstudante() {
const nome = document.getElementById('student-name').value.trim();
const ano = document.getElementById('student-grade').value;
if(!nome || !ano) {
alert('Por favor, preencha seu nome e selecione o seu ano letivo.');
return;
}
document.getElementById('display-user').innerText = nome;
document.getElementById('display-grade').innerText = ano;
document.getElementById('login-screen').style.display = 'none';
inicializarMenu();
}
function mostrarLoginProfessor() {
document.getElementById('login-screen').style.display = 'none';
document.getElementById('teacher-auth-screen').style.display = 'flex';
}
function voltarLoginEstudante() {
document.getElementById('teacher-auth-screen').style.display = 'none';
document.getElementById('login-screen').style.display = 'flex';
}
// Biometria Simulada Avançada
function executarBiometria() {
const laser = document.getElementById('laser');
const status = document.getElementById('bio-status');
const btn = document.getElementById('bio-btn');
laser.style.display = 'block';
status.innerText = 'Escaneando traços faciais e digitais da liderança escolar...';
status.style.color = 'var(--primary)';
btn.disabled = true;
setTimeout(() => {
laser.style.display = 'none';
status.innerText = 'Acesso Biométrico Autenticado com Sucesso!';
setTimeout(() => {
document.getElementById('teacher-auth-screen').style.display = 'none';
document.getElementById('teacher-dashboard').style.display = 'block';
atualizarDashboardProfessor();
}, 1000);
}, 2500);
}
// Transição de Matérias
function mudarDisciplina(disc, elementoMenu) {
disciplinaAtiva = disc;
document.querySelectorAll('.subject-item').forEach(el => el.classList.remove('active'));
elementoMenu.classList.add('active');
document.getElementById('current-subject-title').innerHTML = Disciplina: <span>${disc.nome}</span>;
atualizarTutorIA();
}
// Atualização do Tutor IA Baseado na Matéria Selecionada
function atualizarTutorIA() {
const chatBox = document.getElementById('ia-chat-box');
chatBox.innerHTML = <div class="msg system"> <strong>[Diretriz de Escrita Ativa]</strong><br> Olá! Detectei que você está produzindo conteúdo para <strong>${disciplinaAtiva.nome}</strong>.<br><br> <em>Orientação da IA:</em> ${disciplinaAtiva.prompt} </div> <div class="msg system" style="border-left-color: var(--text-muted); font-size:12px;"> 💡 Certifique-se de anexar representações em PNG transparentes para valorizar a apresentação do trabalho! </div>;
}
// Injeção de Vetor/PNG de Amostragem Transparente Fictício
function injetarVetorExemplo() {
// String base64 de um ícone genérico SVG transparente convertido para simular PNG limpo
const mockupPngTransparente = "data:image/svg+xml;utf8,";
adicionarImagemAoBanco(mockupPngTransparente);
}
// Upload Real de Imagem Local
function handleFileUpload(event) {
const file = event.target.files[0];
if (file) {
const reader = new FileReader();
reader.onload = function(e) {
adicionarImagemAoBanco(e.target.result);
};
reader.readAsDataURL(file);
}
}
function adicionarImagemAoBanco(src) {
bancoImagensTrabalho.push(src);
renderizarPreviaImagens();
}
function removerImagem(index) {
bancoImagensTrabalho.splice(index, 1);
renderizarPreviaImagens();
}
function renderizarPreviaImagens() {
const container = document.getElementById('preview-container');
container.innerHTML = '';
bancoImagensTrabalho.forEach((imgSrc, idx) => {
const wrapper = document.createElement('div');
wrapper.className = 'preview-wrapper';
wrapper.innerHTML = <img src="${imgSrc}" alt="Preview"> <button class="remove-img-btn" onclick="removerImagem(${idx})">×</button>;
container.appendChild(wrapper);
});
}
// Enviar o Trabalho Completo (Salva em LocalStorage para persistência mútua)
function enviarTrabalhoCompleto() {
const nomeAluno = document.getElementById('display-user').innerText;
const anoAluno = document.getElementById('display-grade').innerText;
const textoTrabalho = document.getElementById('work-content').value.trim();
if(nomeAluno === '-' || !textoTrabalho) {
alert('Não é possível submeter um trabalho vazio ou sem identificação de estudante.');
return;
}
const novoTrabalho = {
id: 'trabalho_' + Date.now(),
aluno: nomeAluno,
ano: anoAluno,
disciplina: disciplinaAtiva.nome,
texto: textoTrabalho,
imagens: [...bancoImagensTrabalho],
nota: null,
feedback: null
};
bancoTrabalhosSubmetidos.push(novoTrabalho);
localStorage.setItem('adventista_trabalhos', JSON.stringify(bancoTrabalhosSubmetidos));
alert(Sucesso! Seu trabalho de ${disciplinaAtiva.nome} foi criptografado e transmitido ao portal do professor.);
// Limpar formulário de escrita
document.getElementById('work-content').value = '';
bancoImagensTrabalho = [];
renderizarPreviaImagens();
}
// Métodos do Painel do Professor
function atualizarDashboardProfessor() {
const lista = document.getElementById('submissions-list');
const select = document.getElementById('review-submission-select');
lista.innerHTML = '';
select.innerHTML = 'Nenhum selecionado';
if(bancoTrabalhosSubmetidos.length === 0) {
lista.innerHTML = 'Nenhum trabalho submetido nesta sessão até o momento.';
return;
}
bancoTrabalhosSubmetidos.forEach(trab => {
// Adicionar na listagem visual esquerda
const div = document.createElement('div');
div.className = 'grade-item';
const statusNota = trab.nota !== null ? <span class="badge" style="background:#00ff66; color:#000;">Nota: ${trab.nota}</span> : <span class="badge" style="background:rgba(255,50,50,0.1); color:#ff5555;">Sem Avaliação</span>;
div.innerHTML = <div> <strong>${trab.aluno} (${trab.ano})</strong><br> <span style="font-size:12px; color:var(--text-muted);">Materia: ${trab.disciplina}</span> </div> ${statusNota};
lista.appendChild(div);
// Adicionar no Dropdown de Correção à direita
const opt = document.createElement('option');
opt.value = trab.id;
opt.innerText = ${trab.aluno} - ${trab.disciplina};
select.appendChild(opt);
});
}
function carregarTrabalhoParaRevisao() {
const select = document.getElementById('review-submission-select');
const boxDetalhes = document.getElementById('review-details');
const trabId = select.value;
if(!trabId) {
boxDetalhes.style.display = 'none';
return;
}
const trab = bancoTrabalhosSubmetidos.find(t => t.id === trabId);
if(trab) {
boxDetalhes.style.display = 'block';
document.getElementById('rev-text').innerText = trab.texto;
document.getElementById('review-grade').value = trab.nota || '';
document.getElementById('review-feedback').value = trab.feedback || '';
const containerImagens = document.getElementById('rev-images');
containerImagens.innerHTML = '';
trab.imagens.forEach(src => {
const img = document.createElement('img');
img.src = src;
img.style.maxWidth = '60px';
img.style.maxHeight = '60px';
img.style.border = '1px dashed var(--primary)';
img.style.background = 'rgba(0,0,0,0.4)';
containerImagens.appendChild(img);
});
}
}
function salvarAvaliacaoProfessor() {
const select = document.getElementById('review-submission-select');
const trabId = select.value;
const nota = document.getElementById('review-grade').value;
const feedback = document.getElementById('review-feedback').value;
if(!nota) {
alert('Por favor, atribua uma nota antes de registrar.');
return;
}
const index = bancoTrabalhosSubmetidos.findIndex(t => t.id === trabId);
if(index !== -1) {
bancoTrabalhosSubmetidos[index].nota = parseFloat(nota);
bancoTrabalhosSubmetidos[index].feedback = feedback;
localStorage.setItem('adventista_trabalhos', JSON.stringify(bancoTrabalhosSubmetidos));
alert('Avaliação pedagógica salva e vinculada ao histórico do aluno!');
atualizarDashboardProfessor();
document.getElementById('review-details').style.display = 'none';
}
}


