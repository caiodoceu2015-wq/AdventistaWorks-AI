<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AdventistWorks</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { background: #000; color: #00ff00; font-family: Arial, sans-serif; }
        .container { max-width: 1200px; margin: 0 auto; padding: 20px; }
        header { text-align: center; padding: 30px 0; border-bottom: 3px solid #00ff00; margin-bottom: 30px; }
        h1 { font-size: 2.5rem; color: #00ff00; text-shadow: 0 0 10px rgba(0,255,0,0.5); }
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
        .card { background: #1a1a1a; border: 2px solid #00ff00; border-radius: 10px; padding: 25px; }
        .card:hover { box-shadow: 0 0 30px rgba(0,255,0,0.5); transform: translateY(-5px); }
        .card h2 { color: #00ff00; margin-bottom: 15px; }
        .btn { background: #00ff00; color: #000; padding: 12px 24px; border: none; border-radius: 5px; cursor: pointer; font-weight: bold; width: 100%; margin-top: 15px; }
        .btn:hover { background: #00cc00; }
        .modal { display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); }
        .modal.active { display: flex; justify-content: center; align-items: center; }
        .modal-content { background: #1a1a1a; border: 3px solid #00ff00; border-radius: 15px; padding: 40px; width: 90%; max-width: 600px; }
        .close { color: #00ff00; float: right; font-size: 28px; cursor: pointer; }
        label { display: block; color: #00ff00; margin-top: 15px; font-weight: bold; }
        input, select, textarea { width: 100%; padding: 10px; background: #0a0a0a; border: 2px solid #00ff00; color: #00ff00; border-radius: 5px; margin-top: 5px; font-family: Arial; }
        input:focus, select:focus, textarea:focus { outline: none; box-shadow: 0 0 10px rgba(0,255,0,0.5); }
        .dashboard { display: none; }
        .dashboard.show { display: block; }
        .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; margin: 20px 0; }
        .stat { background: #0a0a0a; border: 2px solid #00ff00; border-radius: 8px; padding: 20px; text-align: center; }
        .stat-num { font-size: 2rem; color: #00ff00; font-weight: bold; }
        .projects { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 15px; margin-top: 20px; }
        .proj { background: #0a0a0a; border: 2px solid #00ff00; border-radius: 8px; padding: 15px; }
        input[type="range"] { padding: 0; }
        input[type="range"]::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 20px; height: 20px; border-radius: 50%; background: #00ff00; cursor: pointer; }
        input[type="range"]::-moz-range-thumb { width: 20px; height: 20px; border-radius: 50%; background: #00ff00; cursor: pointer; border: none; }
    </style>
</head>
<body>
    <div class="container">
        <div id="loginView">
            <header>
                <h1>🎓 AdventistWorks</h1>
                <p style="color: #00ff00; font-size: 1.2rem;">Plataforma de Trabalhos Escolares</p>
            </header>
            <div class="grid">
                <div class="card">
                    <h2>👨‍🎓 Para Alunos</h2>
                    <p style="color: #ccc;">✓ Criar projetos<br>✓ Adicionar imagens PNG<br>✓ Receber orientação IA<br>✓ Acompanhar avaliações</p>
                    <button class="btn" onclick="show('loginModal')">Fazer Login</button>
                </div>
                <div class="card">
                    <h2>👨‍🏫 Para Professores</h2>
                    <p style="color: #ccc;">✓ Ver projetos<br>✓ Avaliar trabalhos<br>✓ Atribuir notas<br>✓ Deixar feedback</p>
                    <button class="btn" onclick="show('loginModal')">Fazer Login</button>
                </div>
                <div class="card">
                    <h2>📚 12 Matérias</h2>
                    <p style="color: #ccc; font-size: 0.9rem;">Português, Literatura, Gramática, Matemática, Ensino Religioso, AdventoTech, Ciências, História, Artes, Geografia, Inglês, Educação Física</p>
                    <button class="btn" onclick="show('registerModal')">Registrar-se</button>
                </div>
            </div>
        </div>
        
        <div id="dashboardView" class="dashboard">
            <header style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; flex-wrap: wrap;">
                <div>
                    <h1>🎓 AdventistWorks</h1>
                    <p id="userGreeting" style="color: #00ff00;"></p>
                </div>
                <button class="btn" style="width: 150px;" onclick="logout()">🚪 Sair</button>
            </header>
            
            <div class="stats">
                <div class="stat"><div class="stat-num" id="totalProjs">0</div><div>Projetos</div></div>
                <div class="stat"><div class="stat-num" id="evalProjs">0</div><div>Avaliados</div></div>
                <div class="stat"><div class="stat-num" id="avgGrade">0</div><div>Nota Média</div></div>
            </div>
            
            <button class="btn" id="newBtn" onclick="show('projectModal')" style="width: 200px; margin: 0 auto; display: block;">➕ Novo Projeto</button>
            <button class="btn" id="evalBtn" onclick="show('evaluateModal')" style="width: 200px; margin: 20px auto 0; display: none;">⭐ Avaliar</button>
            
            <div id="projectsList" class="projects"></div>
        </div>
    </div>
    
    <!-- LOGIN -->
    <div id="loginModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="hide('loginModal')">&times;</span>
            <h2 style="color: #00ff00; margin-bottom: 20px;">🔐 Login</h2>
            <form onsubmit="handleLogin(event)">
                <label>Email:</label>
                <input type="email" id="loginEmail" required>
                <label>Senha:</label>
                <input type="password" id="loginPassword" required>
                <button type="submit" class="btn">✅ Entrar</button>
            </form>
            <p style="text-align: center; margin-top: 20px; color: #ccc;">Novo? <a href="#" onclick="hide('loginModal'); show('registerModal');" style="color: #00ff00; font-weight: bold;">Registre-se</a></p>
        </div>
    </div>
    
    <!-- REGISTER -->
    <div id="registerModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="hide('registerModal')">&times;</span>
            <h2 style="color: #00ff00; margin-bottom: 20px;">✏️ Registrar</h2>
            <form onsubmit="handleRegister(event)">
                <label>Nome:</label>
                <input type="text" id="regName" required>
                <label>Email:</label>
                <input type="email" id="regEmail" required>
                <label>Senha:</label>
                <input type="password" id="regPassword" required>
                <label>Tipo:</label>
                <select id="regType" required>
                    <option value="student">👨‍🎓 Aluno</option>
                    <option value="teacher">👨‍🏫 Professor</option>
                </select>
                <label>Ano:</label>
                <select id="regYear" required>
                    <option>6º</option><option>7º</option><option>8º</option><option>9º</option>
                    <option>1º EM</option><option>2º EM</option><option>3º EM</option>
                </select>
                <button type="submit" class="btn">✅ Criar Conta</button>
            </form>
        </div>
    </div>
    
    <!-- NOVO PROJETO -->
    <div id="projectModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="hide('projectModal')">&times;</span>
            <h2 style="color: #00ff00; margin-bottom: 20px;">✏️ Novo Projeto</h2>
            <form onsubmit="handleNewProject(event)">
                <label>Título:</label>
                <input type="text" id="projTitle" required>
                <label>Matéria:</label>
                <select id="projSubject" required onchange="showAI()">
                    <option value="">Selecione</option>
                    <option value="português">Português</option>
                    <option value="literatura">Literatura</option>
                    <option value="gramática">Gramática</option>
                    <option value="matemática">Matemática</option>
                    <option value="ensino religioso">Ensino Religioso</option>
                    <option value="adventotech">AdventoTech</option>
                    <option value="ciências">Ciências</option>
                    <option value="história">História</option>
                    <option value="artes">Artes</option>
                    <option value="geografia">Geografia</option>
                    <option value="inglês">Inglês</option>
                    <option value="educação física">Educação Física</option>
                </select>
                <label>Descrição:</label>
                <textarea id="projDesc" required></textarea>
                <label>Conteúdo:</label>
                <textarea id="projContent" rows="8" required></textarea>
                <div id="aiBox" style="background: #0a0a0a; border: 2px solid #0066ff; color: #00ccff; padding: 15px; border-radius: 8px; margin: 15px 0; display: none;">
                    <strong>🤖 IA Orientação:</strong>
                    <p id="aiText" style="margin-top: 10px;"></p>
                </div>
                <label>Imagens (PNG):</label>
                <input type="file" id="projImages" multiple accept="image/*">
                <small style="color: #009900;">💡 PNG com transparência é suportado!</small>
                <button type="submit" class="btn">✅ Criar</button>
            </form>
        </div>
    </div>
    
    <!-- AVALIAR -->
    <div id="evaluateModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="hide('evaluateModal')">&times;</span>
            <h2 style="color: #00ff00; margin-bottom: 20px;">⭐ Avaliar Projeto</h2>
            <div id="evalProj" style="background: #0a0a0a; border: 2px solid #00ff00; padding: 15px; border-radius: 8px; margin-bottom: 20px; color: #ccc;"></div>
            <form onsubmit="handleEvaluation(event)">
                <label>📚 Conteúdo (0-10)</label>
                <input type="range" id="gradeContent" min="0" max="10" value="7" onchange="updateGrade()">
                <span id="scoreContent" style="color: #00ff00;">7</span>/10
                
                <label>🎨 Apresentação (0-10)</label>
                <input type="range" id="gradePresent" min="0" max="10" value="7" onchange="updateGrade()">
                <span id="scorePresent" style="color: #00ff00;">7</span>/10
                
                <label>🖼️ Imagens (0-10)</label>
                <input type="range" id="gradeImages" min="0" max="10" value="7" onchange="updateGrade()">
                <span id="scoreImages" style="color: #00ff00;">7</span>/10
                
                <label>✨ Originalidade (0-10)</label>
                <input type="range" id="gradeOrig" min="0" max="10" value="7" onchange="updateGrade()">
                <span id="scoreOrig" style="color: #00ff00;">7</span>/10
                
                <div style="background: #003300; border: 2px solid #00ff00; padding: 20px; border-radius: 8px; margin: 20px 0; text-align: center;">
                    <strong style="color: #00ff00;">Nota Final: <span id="finalGrade" style="font-size: 1.5rem;">7.0</span>/10</strong>
                </div>
                
                <label>💬 Feedback:</label>
                <textarea id="feedback" rows="5" required></textarea>
                <button type="submit" class="btn">✅ Enviar Avaliação</button>
            </form>
        </div>
    </div>
    
    <script>
        let users = JSON.parse(localStorage.getItem('users')) || [];
        let projects = JSON.parse(localStorage.getItem('projects')) || [];
        let evaluations = JSON.parse(localStorage.getItem('evaluations')) || [];
        let currentUser = null;
        let selectedProj = null;
        
        const IA = {
            'português': '📘 Escreva com linguagem clara. Estruture bem em introdução, desenvolvimento e conclusão.',
            'literatura': '📕 Analise personagens, temas e contexto histórico. Cite passagens do texto.',
            'gramática': '✏️ Explique as regras com exemplos práticos. Mostre as exceções.',
            'matemática': '📊 Resolva passo a passo. Mostre todas as fórmulas e cálculos.',
            'ensino religioso': '🙏 Respeite perspectivas. Use fontes confiáveis.',
            'adventotech': '💻 Integre tecnologia com fé. Crie demonstrações interativas.',
            'ciências': '🔬 Pesquise. Descreva experimentos e apresente dados.',
            'história': '📖 Contextualize o período. Identifique personagens-chave.',
            'artes': '🎨 Explore técnicas. Pesquise artistas relacionados.',
            'geografia': '🌍 Use mapas e dados. Analise clima e população.',
            'inglês': '🌐 Use vocabulário apropriado. Revise a gramática.',
            'educação física': '⚽ Pesquise técnicas e regras. Analise movimento.'
        };
        
        function show(id) { document.getElementById(id).classList.add('active'); }
        function hide(id) { document.getElementById(id).classList.remove('active'); }
        
        function handleLogin(e) {
            e.preventDefault();
            const email = document.getElementById('loginEmail').value;
            const pwd = document.getElementById('loginPassword').value;
            const user = users.find(u => u.email === email && u.password === pwd);
            if (user) {
                currentUser = user;
                localStorage.setItem('currentUser', JSON.stringify(user));
                showDash();
                hide('loginModal');
            } else alert('❌ Email ou senha incorretos!');
        }
        
        function handleRegister(e) {
            e.preventDefault();
            if (users.find(u => u.email === document.getElementById('regEmail').value)) {
                alert('❌ Email já registrado!');
                return;
            }
            const user = {
                id: Date.now(),
                name: document.getElementById('regName').value,
                email: document.getElementById('regEmail').value,
                password: document.getElementById('regPassword').value,
                type: document.getElementById('regType').value,
                year: document.getElementById('regYear').value
            };
            users.push(user);
            localStorage.setItem('users', JSON.stringify(users));
            currentUser = user;
            localStorage.setItem('currentUser', JSON.stringify(user));
            showDash();
            hide('registerModal');
            alert('✅ Conta criada!');
        }
        
        function handleNewProject(e) {
            e.preventDefault();
            const proj = {
                id: Date.now(),
                studentId: currentUser.id,
                studentName: currentUser.name,
                title: document.getElementById('projTitle').value,
                subject: document.getElementById('projSubject').value,
                description: document.getElementById('projDesc').value,
                content: document.getElementById('projContent').value,
                status: 'rascunho',
                date: new Date().toLocaleDateString('pt-BR')
            };
            projects.push(proj);
            localStorage.setItem('projects', JSON.stringify(projects));
            hide('projectModal');
            showDash();
            alert('✅ Projeto criado!');
        }
        
        function showAI() {
            const subject = document.getElementById('projSubject').value;
            if (subject) {
                document.getElementById('aiText').textContent = IA[subject] || 'Trabalhe bem!';
                document.getElementById('aiBox').style.display = 'block';
            }
        }
        
        function updateGrade() {
            const c = parseInt(document.getElementById('gradeContent').value);
            const p = parseInt(document.getElementById('gradePresent').value);
            const i = parseInt(document.getElementById('gradeImages').value);
            const o = parseInt(document.getElementById('gradeOrig').value);
            document.getElementById('scoreContent').textContent = c;
            document.getElementById('scorePresent').textContent = p;
            document.getElementById('scoreImages').textContent = i;
            document.getElementById('scoreOrig').textContent = o;
            document.getElementById('finalGrade').textContent = ((c + p + i + o) / 4).toFixed(1);
        }
        
        function handleEvaluation(e) {
            e.preventDefault();
            const eval = {
                id: Date.now(),
                projectId: selectedProj.id,
                grade: parseFloat(document.getElementById('finalGrade').textContent),
                feedback: document.getElementById('feedback').value
            };
            evaluations.push(eval);
            localStorage.setItem('evaluations', JSON.stringify(evaluations));
            const proj = projects.find(p => p.id === selectedProj.id);
            if (proj) proj.status = 'avaliado';
            localStorage.setItem('projects', JSON.stringify(projects));
            hide('evaluateModal');
            showDash();
            alert('✅ Avaliação enviada!');
        }
        
        function showDash() {
            document.getElementById('loginView').style.display = 'none';
            document.getElementById('dashboardView').classList.add('show');
            document.getElementById('userGreeting').textContent = `Bem-vindo, ${currentUser.name}! (${currentUser.type === 'student' ? '👨‍🎓 Aluno' : '👨‍🏫 Professor'})`;
            
            if (currentUser.type === 'teacher') {
                document.getElementById('newBtn').style.display = 'none';
                document.getElementById('evalBtn').style.display = 'block';
            }
            
            let myProjs = currentUser.type === 'student' ? projects.filter(p => p.studentId === currentUser.id) : projects;
            document.getElementById('totalProjs').textContent = myProjs.length;
            const evals = evaluations.filter(e => myProjs.some(p => p.id === e.projectId));
            document.getElementById('evalProjs').textContent = evals.length;
            document.getElementById('avgGrade').textContent = evals.length ? (evals.reduce((s, e) => s + e.grade, 0) / evals.length).toFixed(1) : '0';
            
            const list = document.getElementById('projectsList');
            list.innerHTML = myProjs.map(p => {
                const e = evaluations.find(e => e.projectId === p.id);
                return `<div class="proj"><strong>📚 ${p.title}</strong><br>📖 ${p.subject}<br>📅 ${p.date}<br><span style="color: ${p.status === 'avaliado' ? '#ffff00' : '#00ff00'};">Status: ${p.status}</span>${e ? `<br>⭐ ${e.grade}/10` : ''}</div>`;
            }).join('') || '<p style="text-align: center; color: #ccc;">Nenhum projeto</p>';
        }
        
        function logout() {
            currentUser = null;
            document.getElementById('loginView').style.display = 'block';
            document.getElementById('dashboardView').classList.remove('show');
        }
        
        window.onclick = e => {
            const modals = document.querySelectorAll('.modal.active');
            modals.forEach(m => { if (e.target === m) m.classList.remove('active'); });
        };
        
        // Demo users
        if (!users.length) {
            users = [
                { id: 1, name: 'João Silva', email: 'joao@test.com', password: '123', type: 'student', year: '6º' },
                { id: 2, name: 'Maria', email: 'maria@test.com', password: '123', type: 'teacher', year: '7º' }
            ];
            localStorage.setItem('users', JSON.stringify(users));
        }
    </script>
</body>
</html>